<?xml version="1.0" encoding="utf-8"?>
<package >
  <metadata>
    <id>shengwang_chat_sdk</id>
    <version>1.3.2</version>
    <title>shengwang im sdk wrapper</title>
    <authors>shengwang</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <projectUrl>https://docs.agora.io/en/agora-chat/get-started/get-started-sdk?platform=windows</projectUrl>
    <description>ShengWangChatSDK version 1.3.2</description>
    <repository type="GitHub" url="https://github.com/easemob/emclient-unity"/>
    <releaseNotes>ShengWangChatSDK version 1.3.2</releaseNotes>
    <copyright>ShengWang</copyright>
    <tags>stable 4.12.0</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.5.2" />
      <group targetFramework=".NETFramework4.6.2" />
      <group targetFramework=".NETFramework4.7.2" />
      <group targetFramework=".NETFramework4.8" />
    </dependencies>
  </metadata>
  <files>
      <file src="lib\**" target="lib" />
      <file src="runtimes\x64\native\**" target="runtimes\x64\native\" />
      <file src="shengwang_chat_sdk.props" target="build\net"/>
  </files>
</package>
